# FindJob Copilot 配置文件模板
# 复制此文件为 .env 并填入个人配置

# 1. 大模型配置 (支持 OpenAI、DeepSeek、Claude 或 本地 Ollama)
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2. 本地浏览器配置 (用于 Playwright 复用真实登录态)
# Windows 默认 Chrome 用户数据目录通常位于：%LOCALAPPDATA%\Google\Chrome\User Data
# macOS 默认 Chrome 用户数据目录通常位于：~/Library/Application Support/Google/Chrome
BROWSER_USER_DATA_DIR=C:/Users/<YourUsername>/AppData/Local/Google/Chrome/User Data
BROWSER_HEADLESS=false

# 3. 移动端轻量通知配置 (支持 企业微信机器人 / 微信模板消息 / Server酱 / Bark)
NOTIFICATION_CHANNEL=wechat_webhook
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key

# 4. 服务端口配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
